# Copy to .env and fill in. .env is in .gitignore: never commit it.
# Every service reads the process environment first, then this file.

# The reader. JEV_API_KEY can stay in another file: set JEV_ENV_FILE (or ORB_SECRETS_FILE) to its path.
JEV_API_KEY=
JEV_ENV_FILE=~/jev-test/.env

# The LLM (Ollama).
OLLAMA_URL=http://127.0.0.1:11434
ORB_LLM_MODEL=gemma4:e2b

# Service ports and addresses (all on 127.0.0.1).
ORB_AGENT_PORT=8100
ORB_SPEECH_PORT=8200
ORB_AGENT_URL=http://127.0.0.1:8100
ORB_SPEECH_URL=http://127.0.0.1:8200

# Voice. With no key and a local URL, the public credentials of `livekit-server --dev` are used.
# Any other LiveKit server needs a key and a secret of 32 or more characters.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# With a key and a secret (make a pair with `livekit-server generate-keys`), scripts/dev.sh runs the LiveKit server with
# them instead of the dev server, whose keys are public. Do this when other devices connect (decision 0009).
# With LiveKit Cloud or another public server, set LIVEKIT_URL=wss://<host> instead: dev.sh starts no server then, and
# the worker connects out. LIVEKIT_PUBLIC_URL is the address that browsers use, when it differs from LIVEKIT_URL.
# LIVEKIT_PUBLIC_URL=

# Sharing the page, for example with ngrok. The agent service serves this computer. It refuses a request from a tunnel or
# another device unless the request has this key (16 or more characters). Make one with `openssl rand -hex 16`, then open
# https://<host>/?key=<the key> once on each device. With no key, every such request is refused.
ORB_SHARE_KEY=
# A domain of your ngrok account: dev.sh runs `ngrok http` for the agent service at this address. The page and the voice
# signal both use it. The audio goes straight to this computer: a device needs a network path to it (the same network).
# ORB_NGROK_DOMAIN=your-name.ngrok-free.dev

# Speech models (see packages/python/orb-speech/LLD.md). The bench can ask for any engine per request.
ORB_MODELS_DIR=~/.cache/orb/models
ORB_STT_ENGINE=whistle         # or parakeet (2.3x fewer word errors on accented speech, about 0.1 s per call),
                               # or cartesia (a cloud service: it needs CARTESIA_API_KEY, see below)
ORB_STT_LANGUAGE=en
ORB_STT_FORMAT=written         # or raw: written gives "#4821" and "3:30 PM" for what was said as words (decision 0010)
# ORB_STT_VOCABULARY_FILE=~/orb-team-words.txt  # the team's terms, one per line: names, repos, products (decision 0011)
# ORB_STT_VOCABULARY=useEffect, Redis, LiveKit   # the voice worker's extra terms for its calls (header X-Orb-Vocabulary)
ORB_TTS_ENGINE=kokoro          # maya1 and indic-speak are bench engines: slower than real time on an Apple M5
ORB_TTS_MODEL=kokoro-v1.0.int8.onnx
ORB_TTS_VOICE=af_heart

# Cartesia speech to text (optional, a cloud service). The audio of a call goes to Cartesia, which bills 1 credit for
# each 2 seconds of audio, silence included. The key stays in this file: the speech service reads only CARTESIA_* keys.
CARTESIA_API_KEY=

# The voice worker, in seconds (see apps/voice-agent/LLD.md). The values here are the defaults.
ORB_VAD_THRESHOLD=0.5          # LiveKit's Silero plugin
ORB_VAD_MIN_SPEECH_S=0.05
ORB_VAD_MIN_SILENCE_S=0.55
ORB_VAD_PREFIX_S=0.5
ORB_MIN_ENDPOINTING_S=0.3      # LiveKit's turn detector (v1-mini, local)
ORB_MAX_ENDPOINTING_S=2.5
ORB_MIN_INTERRUPTION_S=0.5     # the agent pauses after this much speech, and only with 2 or more words
ORB_MIN_INTERRUPTION_WORDS=2
ORB_INTERIM_EVERY_S=0.3
ORB_CLOUD_INTERIM_EVERY_S=1.0  # the same for a cloud STT: each interim call pays for the whole piece again
ORB_PREFLIGHT_S=0.15           # after this much silence, a preflight transcript starts the reply early; 0 is off
ORB_PREEMPTIVE=1
ORB_PREEMPTIVE_TTS=1
ORB_FIRST_CLAUSE_CHARS=30      # the first TTS piece can end at a comma after this many characters
ORB_FIRST_PIECE_MAX_CHARS=60   # or at a word boundary, when no comma comes first

# Debug only: save every transcribed piece and turn as WAV + text (real voices; the folder is in .gitignore).
# ORB_DEBUG_AUDIO_DIR=data/debug_audio

# Logs: transcripts stay out of the voice worker log unless this is 1.
ORB_LOG_TEXT=0
